# Local Windows environment. Copy this file to .env and change passwords/keys.
# DATABASE_URL username/password must match the app_user role you create in PostgreSQL.
DATABASE_URL=postgresql+psycopg://app_user:local_app_password@localhost:5432/encryption_db
USE_VAULT_DB_CREDS=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=encryption_db
DB_ROTATION_INTERVAL_SECONDS=1800

# Used by the FastAPI demo endpoints. Change before sharing the project.
API_KEY=local-demo-api-key-change-me
ADMIN_API_KEY=local-demo-admin-key-change-me

# Vault running locally on Windows (not in Docker).
VAULT_ADDR=http://127.0.0.1:8200
VAULT_SETUP_TOKEN=root
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=app-data-key
VAULT_DATABASE_MOUNT=database
VAULT_DATABASE_CONNECTION=postgres
VAULT_DATABASE_ROLE=app-role
VAULT_APPROLE_NAME=student2-app
VAULT_APPROLE_FILE=./vault-credentials.json

# This account is only for Vault's PostgreSQL database plugin in the local lab.
# Change it to match the vault_admin role created in sql/00-create-roles.sql.
VAULT_DB_ADMIN_USER=vault_admin
VAULT_DB_ADMIN_PASSWORD=local_vault_admin_password
