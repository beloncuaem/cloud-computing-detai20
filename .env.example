# Root .env for the Docker Compose lab stack (docker-compose.yml).
# Copy to .env, fill in the keys, and never commit .env.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Required. Compose fails fast if either value is missing or empty.
API_KEY=
ADMIN_API_KEY=

# Host port published for the API container.
API_PORT=8000

# true => the API takes dynamic PostgreSQL credentials from Vault's database engine.
USE_VAULT_DB_CREDS=false
